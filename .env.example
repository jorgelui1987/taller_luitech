APP_NAME="CRM Tienda Celulares"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
FORCE_HTTPS=false

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=luitech
DB_USERNAME=root
DB_PASSWORD=

# Session & Cache
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
CACHE_DRIVER=file

# Queue
QUEUE_CONNECTION=sync

# Security
TRUSTED_PROXIES=*
LOG_LEVEL=warning