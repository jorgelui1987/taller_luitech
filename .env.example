APP_NAME="CRM Tienda Celulares"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FORCE_HTTPS=false

# Database Configuration (PostgreSQL - Dokploy)
DB_CONNECTION=pgsql
DB_HOST=taller-taller-vosdbx
DB_PORT=5432
DB_DATABASE=tiendacelulares_crm
DB_USERNAME=tiendacelulares_crm
DB_PASSWORD=TU_CONTRASENA_AQUI
DB_SSLMODE=prefer

# Session & Cache
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
CACHE_DRIVER=file

# Queue
QUEUE_CONNECTION=sync

# Security
TRUSTED_PROXIES=*
LOG_LEVEL=debug

# Credenciales del SuperAdmin (panel /superadmin/login)
# En producción (Dokploy) define estas mismas variables en → Variables de entorno.
SUPERADMIN_EMAIL=luitechserena@gmail.com
SUPERADMIN_PASSWORD=password
