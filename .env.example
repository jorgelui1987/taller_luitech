APP_NAME="CRM Tienda Celulares"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://luitech.fun
FORCE_HTTPS=true
SESSION_SECURE_COOKIE=true

# Database Configuration (MariaDB / MySQL)
DB_CONNECTION=mariadb
DB_HOST=taller-serviciotecnico-ydeut5
DB_PORT=3306
DB_DATABASE=tiendacelulares_crm
DB_USERNAME=tiendacelulares_crm
DB_PASSWORD=

# Session & Cache
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_DRIVER=file

# Queue
QUEUE_CONNECTION=sync

# Security
TRUSTED_PROXIES=*
LOG_LEVEL=warning