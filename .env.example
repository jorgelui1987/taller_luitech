APP_NAME="CRM Tienda Celulares"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FORCE_HTTPS=false

# Database Configuration (PostgreSQL - Dokploy)
DB_CONNECTION=pgsql
DB_HOST=taller-taller-vosdbx
DB_PORT=5432
DB_DATABASE=tiendacelulares_crm
DB_USERNAME=tiendacelulares_crm
DB_PASSWORD=TU_CONTRASENA_AQUI
DB_SSLMODE=prefer

# Session & Cache
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
CACHE_DRIVER=file

# Queue
QUEUE_CONNECTION=sync

# Security
TRUSTED_PROXIES=*
LOG_LEVEL=debug

# Credenciales del SuperAdmin (panel /superadmin/login)
# En producción (Dokploy) define estas mismas variables en → Variables de entorno.
# ⚠️ Solo se usan al CREAR el superadmin si no existe. El entrypoint NO pisa
# la clave en cada arranque: si la cambiaste en BD se conserva tras redeploys.
SUPERADMIN_EMAIL=luitechserena@gmail.com
SUPERADMIN_PASSWORD=password
# Token de emergencia para /recuperar-superadmin/{token}. Vacío = desactivado.
SUPERADMIN_RECOVERY_TOKEN=

# Marca de la plataforma (landing principal). Sin esto usa LUITECH por defecto.
PLATFORM_BRAND_NAME="Servicio Técnico"
PLATFORM_EMAIL=contacto@serviciotecnico.fun
PLATFORM_TELEFONO=+56 9 8220 9690
PLATFORM_DIRECCION="Bernardo O'Higgins 564, La Serena"

# Correo SMTP (recuperación de contraseña y avisos). Sin esto no se envían mails.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=contacto@serviciotecnico.fun
MAIL_FROM_NAME="Servicio Técnico"
